# Fill these two values. Keep this file private.
BOT_TOKEN=
GROQ_API_KEY=

# Groq text model
GROQ_MODEL=openai/gpt-oss-120b
MAX_OUTPUT_TOKENS=4096
MAX_CONCURRENT_REQUESTS=8
REQUEST_TIMEOUT=180
MAX_CONTEXT_CHARS=40000

# Telegram settings; existing account defaults are retained if omitted.
DRAFT_STREAMING=true
GROUP_MENTIONS_ONLY=false
# ADMIN_ID=629986639
# BOT_USERNAME=queryaibot
# CHANNEL_ID=-1002081366095
# CHANNEL_URL=https://t.me/BotCommunityHub
# Set LOG_CHANNEL_ID= to disable logging.
# LOG_CHANNEL_ID=-1002224010991
# DATA_DIR=./data

# Image extraction and current-context web search
OCR_MODE=auto
OCR_URL=https://ai-service-prod.compscilib.com/image-to-text
# Uses GROQ_API_KEY to review weak OCR or visual questions before the main model.
VISION_ENABLED=true
GROQ_VISION_MODEL=qwen/qwen3.8-27b
WEB_ENABLED=true
# Native browser-search backup (uses the same GROQ_API_KEY)
GROQ_WEB_MODEL=openai/gpt-oss-120b

# Image generation: primary fal, automatic getimg fallback
FAL_API_KEY=
GETIMG_API_KEY=
# Optional private staging channel for inline/guest images (bot must post there).
# Otherwise uses LOG_CHANNEL_ID. Never uploads to the requesting user DM.
# Bot needs photo-posting and message-deletion permissions in the upload chat.
IMAGE_CACHE_CHAT_ID=

# Telegram: safe retries for edits/downloads and pre-send connection failures.
TELEGRAM_RETRIES=4

# Premium agents: plans and tools are bounded even though premium has no question quota.
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT=360

# Execution is OFF until rootless Docker (or gVisor runsc) is installed and tested.
# Build with: docker build -t qtfixed-sandbox:1 sandbox
SANDBOX_ENABLED=false
SANDBOX_IMAGE=qtfixed-sandbox:1
SANDBOX_RUNTIME=
SANDBOX_TIMEOUT=30
SANDBOX_CONCURRENCY=2
# For rootless Docker, substitute your bot service user's numeric UID:
# DOCKER_HOST=unix:///run/user/1000/docker.sock
